# Copy to .env and fill in real values. Never commit .env — see src/config/config.ts
# (added in a later module), which parses these with zod and fails loudly on anything
# missing or malformed. Nothing here has a working default in production.

NODE_ENV=development
INSTANCE_ID=local-dev
PORT=3000

# PostgreSQL 17 — see Database.md. Local dev target is the docker-compose service on 5432
# (user/db "ekw" per Architecture.md "Deployment Shape" docker-compose.yml).
DATABASE_URL=postgres://ekw:ekw@localhost:5432/ekw
DB_POOL_MAX=10
DB_SSL=false
# Only ever true when NODE_ENV=development.
DB_AUTO_MIGRATE=true

# Yjs collaboration relay (src/collab-server/main.ts, `npm run collab`).
COLLAB_WS_URL=ws://localhost:1234
COLLAB_WS_PORT=1234

# Git-sync export worker.
GIT_SYNC_ENABLED=false
GIT_SYNC_REPO_PATH=./data/git-sync
GIT_SYNC_BRANCH=main
GIT_SYNC_INTERVAL_MS=300000
GIT_AUTHOR_NAME=okf-sync
GIT_AUTHOR_EMAIL=okf-sync@localhost

LOG_LEVEL=info
