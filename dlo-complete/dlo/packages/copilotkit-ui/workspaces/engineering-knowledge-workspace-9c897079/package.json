{
  "name": "engineering-knowledge-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A collaborative, block-based engineering knowledge workspace for Google Cloud's Open Knowledge Format (OKF), built on TanStack Start, Meta Astryx/StyleX, Lexical, Yjs, Relay and PostgreSQL 17.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --config app.config.ts",
    "build": "vite build --config app.config.ts",
    "start": "vite preview --port 3000 --config app.config.ts",
    "collab": "node --experimental-strip-types src/server/collab-server.ts",
    "typecheck": "tsc --noEmit",
    "relay": "relay-compiler",
    "schema:emit": "node scripts/schema-emit.mjs",
    "migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.8",
    "@astryxdesign/theme-neutral": "0.1.8",
    "@lexical/code": "0.48.0",
    "@lexical/link": "0.48.0",
    "@lexical/list": "0.48.0",
    "@lexical/markdown": "0.48.0",
    "@lexical/react": "0.48.0",
    "@lexical/rich-text": "0.48.0",
    "@lexical/selection": "0.48.0",
    "@lexical/utils": "0.48.0",
    "@lexical/yjs": "0.48.0",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-router": "^1.100.0",
    "@tanstack/react-start": "^1.100.0",
    "graphql": "^16.9.0",
    "lexical": "0.48.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-relay": "21.0.1",
    "relay-runtime": "21.0.1",
    "y-protocols": "1.0.7",
    "y-websocket": "3.0.0",
    "yaml": "^2.6.1",
    "yjs": "13.6.31",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.1.8",
    "@astryxdesign/cli": "0.1.8",
    "@stylexjs/unplugin": "0.19.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "babel-plugin-relay": "21.0.1",
    "jsdom": "^25.0.1",
    "relay-compiler": "21.0.1",
    "relay-test-utils": "21.0.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.3",
    "vitest": "^3.0.0"
  }
}
